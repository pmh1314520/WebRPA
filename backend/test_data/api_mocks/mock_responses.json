          "data: {\"id\":\"chatcmpl-test-001\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"delta\":{\"content\":\"！\"},\"index\":0}]}\n\n",
          "data: {\"id\":\"chatcmpl-test-001\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"delta\":{\"content\":\"世界\"},\"index\":0}]}\n\n",
          "data: [DONE]\n\n"
