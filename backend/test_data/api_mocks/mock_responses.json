  "error_scenarios": [
    {
      "scenario": "network_timeout",
      "description": "网络超时",
      "delay_ms": 30000,
      "expected_behavior": "timeout_error"
    },
    {
      "scenario": "connection_refused",
      "description": "连接被拒绝",
      "status": 0,
      "expected_behavior": "connection_error"
    },
    {
      "scenario": "dns_resolution_failed",
      "description": "DNS 解析失败",
      "hostname": "nonexistent.example.com",
      "expected_behavior": "dns_error"
    },
    {
      "scenario": "ssl_certificate_error",
      "description": "SSL 证书错误",
      "expected_behavior": "ssl_error"
    },
    {
      "scenario": "malformed_json_response",
      "description": "返回非法 JSON",
      "status": 200,
      "raw_response": "{ invalid json }}}",
      "expected_behavior": "json_parse_error"
    },
    {
      "scenario": "empty_response_body",
      "description": "空响应体",
      "status": 200,
      "raw_response": "",
      "expected_behavior": "empty_response"
    },
    {
      "scenario": "server_error_500",
      "description": "服务器内部错误",
      "status": 500,
      "response": { "error": "internal_server_error" },
      "expected_behavior": "server_error"
    }
  ]
