# ============================================
# Backend .gitignore
# ============================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
env/
ENV/

# 上传文件（用户数据，可能含敏感内容）
uploads/
browser_data/

# poppler 工具（体积较大，用户需自行下载）
poppler/

# AI 模型文件（体积巨大）
data/easyocr_models/
data/whisper_models/
models/

# ============ 用户数据/敏感数据（防泄露） ============
# 计划任务及其日志
data/scheduled_tasks.json
data/scheduled_task_logs.json

# 后端持久化全局变量（用户可能存放 Token 等）
data/global_vars.json

# 收集数据的完整落盘（运行时数据，可能含用户业务数据）
data/_full_data/

# MCP 服务器配置（用户配的可能含 API Key / Token 等敏感信息）
data/mcp_config.json

# 工作流保存文件夹（活动文件夹，含用户机器本地绝对路径）—— 运行时状态，不入库
data/workflow_folder.json

# WebDAV 配置（含远程账号/密码）—— 不入库
data/webdav.json

# 自定义模块（可能含用户业务逻辑）
data/custom_modules/

# AI 助手会话历史 + 长期记忆（含用户对话内容）
data/ai_assistant/

# 自动化日志
@AutomationLog.txt
allure_reports/
recordings/
app/executors/_registry_manifest.json
data/security.json
data/command_audit.log
.pytest_cache/
tests/__pycache__/

# 日志
*.log

# 临时文件
*.tmp
*.temp
*.bak
*.backup

# 操作系统
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# 环境变量
.env
.env.local

# 运行时数据（执行历史/告警/编排/队列/单测/探针/发布/知识库/任务计划）—— 不入库
data/execution_history.jsonl
data/alert_config.json
data/pipelines.json
data/run_queue_config.json
data/workflow_tests.json
data/health_probes.json
data/published_workflows.json
data/task_plan.json
data/knowledge_base/

# 企业级平台能力（含口令哈希/密钥/会话/审计/审批/ACL/节点 token 等敏感数据）—— 不入库
data/rbac.json
data/sessions.json
data/.rbac_secret
data/sso_config.json
data/audit_log.jsonl
data/audit_archive/
data/audit_checkpoint.json
data/approvals.json
data/vault_acl.json
data/robots.json
data/cluster_tasks.json
data/idp_templates.json
data/computer_use_sessions.json
data/rbac_enforce.json
data/health_inspect.json
data/cluster_node_identity.json
