# ============================================
# WebRPA 项目 .gitignore
# ============================================

# ============================================
# 运行环境（体积巨大，不应提交到仓库）
# ============================================

# Python 3.13 运行环境（约 1-2GB）
Python313/

# Node.js 运行环境（约 100-200MB）
nodejs/

# NapCat QQ机器人框架（完整忽略）
NapCat/

# ============================================
# 依赖包和构建产物
# ============================================

# Node.js 依赖
node_modules/
**/node_modules/

# Python 缓存
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 前端构建产物
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ============================================
# 数据库和数据文件
# ============================================

# SQLite 数据库
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 工作流数据
frameworkHub/data/workflows.db

# 定时任务数据
backend/data/scheduled_tasks.json
backend/data/scheduled_task_logs.json

# ============================================
# 上传和临时文件
# ============================================

# 后端上传文件
backend/uploads/
backend/browser_data/

# Excel 和图片资源（用户上传的文件）
backend/uploads/excel/
backend/uploads/images/

# AI 模型文件（体积巨大）
backend/data/easyocr_models/
backend/data/whisper_models/

# ============================================
# 日志文件
# ============================================

# 所有日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# 进程 PID 文件
# ============================================

*.pid
.backend.pid
.frontend.pid
.frontend-nodes.pid

# ============================================
# 环境变量和配置
# ============================================

# 环境变量文件
.env
.env.local
.env.*.local

# 启动器本地 UI 设置（本机状态，不入库）
launcher_settings.json

# 用户配置（可能包含敏感信息）
# WebRPAConfig.json 保留，因为是示例配置

# ============================================
# IDE 和编辑器
# ============================================

# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# 操作系统
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# 临时文件和缓存
# ============================================

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# 运行时生成的初始管理员密码（敏感，禁止提交）
backend/data/INITIAL_ADMIN_PASSWORD.txt

# 测试文件（自测后应删除）
test_*.py
test_*.js
test_*.ts
*_test.py
*_test.js
*_test.ts

# 例外：正式分层测试套件必须纳入版本控制（覆盖上面的临时测试忽略规则）
# 后端 backend/tests 下的所有测试与前端 __tests__ 目录均需提交，CI 才能执行回归防护。
!backend/tests/
!backend/tests/**
!frontend/src/**/__tests__/
!frontend/src/**/__tests__/**

# 备份文件
*.bak
*.backup
*.old
*.orig

# ============================================
# 媒体处理工具（体积较大）
# ============================================

# FFmpeg 可执行文件（约 100MB）
backend/ffmpeg.exe
backend/ffprobe.exe
backend/m3u8.exe
backend/pandoc.exe

# scrcpy 手机镜像工具（约 50MB）
backend/scrcpy/

# 用户需要自行下载

# ============================================
# 其他
# ============================================

# 压缩文件
*.zip
*.rar
*.7z
*.tar
*.gz

# Excel 测试文件
table_data.xlsx

# 工作流测试文件
workflows/*.json
!workflows/.gitkeep

# ============================================
# 启动器开发文件（不开源）
# ============================================

# Tauri 启动器编译产物
launcher/dist/
launcher/node_modules/
launcher/src-tauri/target/
launcher/src-tauri/Cargo.lock

# 但是保留源代码以便追踪修改
!launcher/src/
!launcher/src-tauri/src/
!launcher/package.json
!launcher/vite.config.js
!launcher/src-tauri/Cargo.toml
!launcher/src-tauri/tauri.conf.json
# AI 助手会话历史 + 全局变量（含用户隐私）
backend/data/global_vars.json
backend/data/ai_assistant/
backend/data/custom_modules/

# 一键清空敏感数据脚本（仅本地使用，不开源）
一键清空敏感数据.bat
_clean_sensitive_data.ps1

# 本地更新日志草稿（用户在测试时记录的笔记，不入仓）
WebRPA v*.md

# 本地一键更新脚本（不入库）
一键更新WebRPA版本.bat
一键更新WebRPA版本.txt
_update_version.ps1

# ============================================
# Local/private folders excluded from GitHub
# ============================================

# Exclude all dot-prefixed folders at any level
.*/
**/.*/

# 除「免启动器运行WebRPA.bat」外的所有 .bat 脚本一律不入库
# （打包/构建/维护/开发用脚本仅本机使用，不随开源仓库分发）
*.bat
!免启动器运行WebRPA.bat

# Exclude WebRPA official website source
website/

# 临时端到端联调脚本 / 误生成的双层路径目录（测试从 backend 目录跑时产生）
_e2e_*.py
backend/backend/
# 工作流打包产物（体积大，不入库）
packaged/

# 浏览器扩展手动测试用的临时测试扩展（本地自测，不入库）
_manual_test_extension/
_manual_test_extension_2/
_manual_test_extension_3/

# 运行日志（本地产物，不入库）
@AutomationLog.txt

# WebView2 运行库安装器（第三方大体积二进制，随发布包分发，不入库）
启动器双击后报错？双击安装WebView2运行环境.exe
